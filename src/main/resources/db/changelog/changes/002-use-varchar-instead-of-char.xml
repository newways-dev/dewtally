<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      CHAR(n) pads values with spaces in PostgreSQL and does not match
      Hibernate's String mapping (VARCHAR).
    -->
    <changeSet id="006-use-varchar-instead-of-char" author="kate">
        <modifyDataType tableName="invoice_document" columnName="sha256" newDataType="VARCHAR(64)"/>
        <modifyDataType tableName="invoice" columnName="currency" newDataType="VARCHAR(3)"/>

        <rollback>
            <modifyDataType tableName="invoice_document" columnName="sha256" newDataType="CHAR(64)"/>
            <modifyDataType tableName="invoice" columnName="currency" newDataType="CHAR(3)"/>
        </rollback>
    </changeSet>

</databaseChangeLog>