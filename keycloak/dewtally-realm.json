{
  "realm": "dewtally",
  "enabled": true,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "clerk",
        "description": "Uploads, checks and corrects invoices"
      },
      {
        "name": "approver",
        "description": "Accepts and rejects invoices, verifies IBANs"
      },
      {
        "name": "admin",
        "description": "Manages supplier master data"
      }
    ]
  },
  "groups": [
    {
      "name": "Demo GmbH",
      "attributes": {
        "tenant_id": [
          "544cc1a9-416b-4715-ac24-cb559d89e262"
        ]
      }
    },
    {
      "name": "Other AG",
      "attributes": {
        "tenant_id": [
          "7d3f2c1e-5b4a-4c3d-9e8f-0a1b2c3d4e5f"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "dewtally-cli",
      "name": "dewtally local testing (curl, Postman)",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "dewtally-web",
      "name": "dewtally web UI",
      "description": "Next.js server (backend for frontend): authorization code with PKCE, tokens never reach the browser",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${DEWTALLY_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${DEWTALLY_WEB_URL}/*"
      ],
      "webOrigins": [
        "${DEWTALLY_WEB_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${DEWTALLY_WEB_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "anna",
      "enabled": true,
      "emailVerified": true,
      "email": "anna@demo.example",
      "firstName": "Anna",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "anna",
          "temporary": false
        }
      ],
      "realmRoles": [
        "clerk"
      ],
      "groups": [
        "/Demo GmbH"
      ]
    },
    {
