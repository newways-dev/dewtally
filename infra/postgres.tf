# Server names are global in Azure: a random suffix keeps ours unique.
resource "random_string" "suffix" {
  length  = 6
  upper   = false
  special = false
}

# Generated by Terraform: nobody types or knows it. It goes to Key Vault, and from there to the application.
resource "random_password" "db" {
  length  = 32
  special = false
}

# Managed PostgreSQL: Azure takes care of backups and patches.
resource "azurerm_postgresql_flexible_server" "main" {
  name                          = "psql-${var.prefix}-${random_string.suffix.result}"
  location                      = azurerm_resource_group.main.location
  resource_group_name           = azurerm_resource_group.main.name
  version                       = "17"
  sku_name                      = "B_Standard_B1ms" # smallest burstable size: enough for a demo
  storage_mb                    = 32768
  backup_retention_days         = 7
  administrator_login           = "dewtally"
  administrator_password        = random_password.db.result
  public_network_access_enabled = true
  tags                          = var.tags

  # Azure picks an availability zone itself; without this, every plan would try to change it back.
  lifecycle {
    ignore_changes = [zone]
  }
}

resource "azurerm_postgresql_flexible_server_database" "dewtally" {
  name      = "dewtally"
  server_id = azurerm_postgresql_flexible_server.main.id
  charset   = "UTF8"
  collation = "en_US.utf8"
}

# Only services inside Azure may connect (the special 0.0.0.0 rule), not the whole internet.
# A private virtual network would be stricter; it is a known gap in the roadmap.
resource "azurerm_postgresql_flexible_server_firewall_rule" "azure_services" {
  name             = "allow-azure-services"
  server_id        = azurerm_postgresql_flexible_server.main.id
  start_ip_address = "0.0.0.0"
  end_ip_address   = "0.0.0.0"
}
