# Copy to .env.local and fill in BETTER_AUTH_SECRET. Local development values only.

# Keycloak realm and the web client (secret matches compose.yaml, local only)
KEYCLOAK_ISSUER=http://localhost:8180/realms/dewtally
KEYCLOAK_CLIENT_ID=dewtally-web
KEYCLOAK_CLIENT_SECRET=local-dev-only-web-secret

# Backend API, called only from the Next.js server
API_URL=http://localhost:8080

# Better Auth: public URL of the web UI and a random secret that encrypts the session cookies.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=