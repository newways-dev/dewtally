# Secrets of the web UI, generated by Terraform: nobody types or knows them.
resource "random_password" "better_auth" {
  length  = 48
  special = false
}

resource "random_password" "web_client" {
  length  = 32
  special = false
}

# Encrypts the session cookie that holds the user's Keycloak tokens
resource "azurerm_key_vault_secret" "better_auth_secret" {
  name         = "better-auth-secret"
  value        = random_password.better_auth.result
  key_vault_id = azurerm_key_vault.main.id
  depends_on   = [azurerm_role_assignment.terraform_writes_secrets]
}

# Password of the "dewtally-web" client: Keycloak gets it on the realm import, the web UI uses it to log users in
resource "azurerm_key_vault_secret" "web_client_secret" {
  name         = "keycloak-web-client-secret"
  value        = random_password.web_client.result
  key_vault_id = azurerm_key_vault.main.id
  depends_on   = [azurerm_role_assignment.terraform_writes_secrets]
}

locals {
  # Azure gives every app "<name>.<environment domain>": known before the app exists,
  # so Keycloak can be told the web UI's address without waiting for it.
  web_url = "https://web.${azurerm_container_app_environment.main.default_domain}"
}

# Web UI (Next.js). Backend for frontend: the browser only talks to this app, which calls the API with the
# user's token. The token never reaches the browser.
resource "azurerm_container_app" "web" {
  name                         = "web"
  container_app_environment_id = azurerm_container_app_environment.main.id
  resource_group_name          = azurerm_resource_group.main.name
  revision_mode                = "Single"
  tags                         = var.tags

  identity {
    type         = "UserAssigned"
    identity_ids = [azurerm_user_assigned_identity.apps.id]
  }

  secret {
    name                = "better-auth-secret"
    key_vault_secret_id = azurerm_key_vault_secret.better_auth_secret.versionless_id
    identity            = azurerm_user_assigned_identity.apps.id
  }

  secret {
    name                = "keycloak-web-client-secret"
    key_vault_secret_id = azurerm_key_vault_secret.web_client_secret.versionless_id
    identity            = azurerm_user_assigned_identity.apps.id
  }

  # Public HTTPS; Azure terminates TLS and forwards to Next.js on port 3000
  ingress {
    external_enabled = true
    target_port      = 3000

    traffic_weight {
      latest_revision = true
      percentage      = 100
    }
  }

  template {
    min_replicas = 1
    max_replicas = 1

    container {
      name   = "web"
      image  = "${var.image_registry}/dewtally-web:${var.image_tag}"
      cpu    = 0.5
      memory = "1Gi"

      # The same settings as web/.env.local, pointed at the Azure addresses
      env {
        name  = "KEYCLOAK_ISSUER"
        value = "${local.keycloak_url}/realms/dewtally"
      }
      env {
        name  = "KEYCLOAK_CLIENT_ID"
        value = "dewtally-web"
      }
      env {
        name        = "KEYCLOAK_CLIENT_SECRET"
        secret_name = "keycloak-web-client-secret"
      }
      env {
        name  = "API_URL"
        value = "https://${azurerm_container_app.api.ingress[0].fqdn}"
      }
      env {
        name  = "BETTER_AUTH_URL"
        value = local.web_url
      }
      env {
        name        = "BETTER_AUTH_SECRET"
        secret_name = "better-auth-secret"
      }

      # Next.js starts in seconds; TCP is enough to know the server is listening
      startup_probe {
        transport               = "TCP"
        port                    = 3000
        interval_seconds        = 5
        failure_count_threshold = 12
      }
    }
  }

  depends_on = [azurerm_role_assignment.apps_read_secrets]
}
